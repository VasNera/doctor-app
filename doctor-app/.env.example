# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored and is read by docker-compose.yml.

# Password for the application database user (`doctorappuser`).
MYSQL_PASSWORD=choose-a-password

# Password for the MySQL root user (used by the container's healthcheck).
MYSQL_ROOT_PASSWORD=choose-another-password

# Signing key for JWT tokens. Must be Base64-encoded and at least 256 bits.
# The value below is a throwaway development key and works out of the box.
# For anything beyond local use, generate your own:  openssl rand -base64 32
JWT_SECRET_KEY=qPVyMpmTP9O6YDdh5A1EHpzYeG3C/FRRNhcYDWuXAJA=

# Mailtrap sandbox credentials (https://mailtrap.io - free).
# Only needed to send doctor activation emails; the app starts without them,
# and the seeded demo doctor is already activated, so you can leave them empty.
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
